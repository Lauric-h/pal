{{ define "library" -}}
{{ template "layout-start" . }}
<header class="page-header library-header">
    {{ if .GenreFilterName }}<h1>{{ .GenreFilterName }}</h1>{{ else }}<h1>Bibliothèque</h1>{{ end }}
    <p class="library-summary">{{ .TotalCount }} livre{{ if ne .TotalCount 1 }}s{{ end }}</p>
</header>

<div class="library-toolbar">
    <nav class="status-pills" aria-label="Filtrer par statut">
       <a class="status-pill-link{{ if eq .StatusFilter "" }} active{{ end }}" href="/library{{ if .GenreFilterID }}?genre={{ .GenreFilterID }}{{ end }}">Tous <span class="pill-count">{{ .TotalCount }}</span></a>
       {{ range .StatusCounts }}
       <a class="status-pill-link{{ if eq $.StatusFilter .Status }} active{{ end }}" href="/library?status={{ .Status }}{{ if $.GenreFilterID }}&genre={{ $.GenreFilterID }}{{ end }}">{{ .Label }} <span class="pill-count">{{ .Count }}</span></a>
       {{ end }}
    </nav>

    <form class="library-genre-filter" method="get" action="/library">
       {{ if .StatusFilter }}<input type="hidden" name="status" value="{{ .StatusFilter }}">{{ end }}
       <label class="sr-only" for="genre-filter">Genre</label>
       <select id="genre-filter" name="genre" onchange="this.form.submit()">
          <option value=""{{ if eq .GenreFilterID 0 }} selected{{ end }}>Tous les genres</option>
          {{ range .Genres }}
          <option value="{{ .ID }}"{{ if eq $.GenreFilterID .ID }} selected{{ end }}>{{ .Name }}</option>
          {{ end }}
       </select>
    </form>
</div>

{{ if .TitleGroups }}
<div class="library-table">
    <div class="library-table-head">
       <span>Titre</span>
       <span>Genre</span>
       <span>Statut</span>
       <span>Progression</span>
       <span>Actions</span>
    </div>
    {{ range .TitleGroups }}
    <div class="letter-group">
       <div class="letter-marker">{{ .Letter }}</div>
       {{ range .Books }}{{ template "book-row" . }}{{ end }}
    </div>
    {{ end }}
</div>
{{ else }}
<div class="empty-state"><div class="empty-icon" aria-hidden="true">▣</div><p>Aucun livre trouvé.</p></div>
{{ end }}
{{ template "layout-end" . }}
{{ end }}
